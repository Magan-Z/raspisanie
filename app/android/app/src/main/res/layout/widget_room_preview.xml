<?xml version="1.0" encoding="utf-8"?>
<!-- Превью для галереи виджетов (статичный пример).  Виджет 3×1: только аудитория — крупно, с названием пары рядом. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:text="2-05"
        android:id="@+id/room"
        android:layout_width="86dp"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="38sp"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/widget_plate"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:textColor="@color/widget_text"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
        android:text="СЕЙЧАС"
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_accent"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
        <TextView
        android:text="Технологическое предпринимательство"
            android:id="@+id/subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countdown"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
        <TextView
        android:text="до конца 1 ч"
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
