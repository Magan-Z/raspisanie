<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Домашка»: ближайшие невыполненные задания, цвет предмета и срок. Нажатие — вкладка «ДЗ». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:layout_marginBottom="2dp">
        <TextView
        style="@style/W.Title"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
        style="@style/W.Chip"
            android:id="@+id/count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />
        <TextView
        style="@style/W.Button"
            android:id="@+id/add_homework"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_add_homework" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hw_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">
        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:id="@+id/hw_dot_1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_accent"
            android:importantForAccessibility="no" />
        <TextView
        style="@style/W.Row"
            android:id="@+id/hw_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textSize="13sp" />
        <TextView
        style="@style/W.Label"
            android:id="@+id/hw_due_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_highlight"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hw_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">
        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:id="@+id/hw_dot_2"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_accent"
            android:importantForAccessibility="no" />
        <TextView
        style="@style/W.Row"
            android:id="@+id/hw_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textSize="13sp" />
        <TextView
        style="@style/W.Label"
            android:id="@+id/hw_due_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_highlight"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hw_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">
        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:id="@+id/hw_dot_3"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_accent"
            android:importantForAccessibility="no" />
        <TextView
        style="@style/W.Row"
            android:id="@+id/hw_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textSize="13sp" />
        <TextView
        style="@style/W.Label"
            android:id="@+id/hw_due_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_highlight"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hw_row_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">
        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:id="@+id/hw_dot_4"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_accent"
            android:importantForAccessibility="no" />
        <TextView
        style="@style/W.Row"
            android:id="@+id/hw_title_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textSize="13sp" />
        <TextView
        style="@style/W.Label"
            android:id="@+id/hw_due_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_highlight"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" />
    </LinearLayout>
</LinearLayout>
