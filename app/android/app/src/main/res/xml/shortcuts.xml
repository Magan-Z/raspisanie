<?xml version="1.0" encoding="utf-8"?>
<!-- Быстрые действия: долгое нажатие на значок приложения. Показываются первые четыре. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_homework"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_homework_short"
        android:shortcutLongLabel="@string/shortcut_add_homework_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="raspisanie://homework/new"
            android:targetClass="ru.raspisanie.raspisanie.MainActivity"
            android:targetPackage="ru.raspisanie.raspisanie" />
    </shortcut>
    <shortcut
        android:shortcutId="tomorrow"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_tomorrow"
        android:shortcutShortLabel="@string/shortcut_tomorrow_short"
        android:shortcutLongLabel="@string/shortcut_tomorrow_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="raspisanie://day/tomorrow"
            android:targetClass="ru.raspisanie.raspisanie.MainActivity"
            android:targetPackage="ru.raspisanie.raspisanie" />
    </shortcut>
    <shortcut
        android:shortcutId="week"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_week"
        android:shortcutShortLabel="@string/shortcut_week_short"
        android:shortcutLongLabel="@string/shortcut_week_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="raspisanie://week"
            android:targetClass="ru.raspisanie.raspisanie.MainActivity"
            android:targetPackage="ru.raspisanie.raspisanie" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="raspisanie://search"
            android:targetClass="ru.raspisanie.raspisanie.MainActivity"
            android:targetPackage="ru.raspisanie.raspisanie" />
    </shortcut>
</shortcuts>
